{
  "name": "weather-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "react",
    "Backend"
  ],
  "scripts": {
    "build": "npm --prefix react run build",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --prefix react run dev",
    "dev:backend": "npm --prefix Backend run dev",
    "start": "npm --prefix Backend start"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
