# OpenWeatherMap API Key (Get a free API key at https://openweathermap.org/api)
WEATHER_API_KEY=your_openweathermap_api_key_here

# Backend Server Port (default 5001 to avoid macOS AirPlay conflict on 5000)
PORT=5001

# Allowed Frontend Origins for Backend CORS (comma-separated)
FRONTEND_URL=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
